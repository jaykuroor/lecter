{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "root": "..", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!node_modules", "!test-results", "!playwright-report", "!src/core/bindings.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error", "noFocusedTests": "error", "noSkippedTests": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
