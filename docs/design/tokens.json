{
  "$comment": "Lecter design tokens from the concept demo (D-036). Bundled default 'Lecter' theme and fallback. On Linux the GTK theme overrides each colour named in 'gtk' (12-settings-theme-onboarding.md#theme). UI code uses only these, as CSS custom properties --<name>.",
  "color": {
    "window-bg": {
      "light": "#fafafb",
      "dark": "#222226",
      "gtk": "window_bg_color"
    },
    "window-fg": {
      "light": "#2e2e32",
      "dark": "#ffffff",
      "gtk": "window_fg_color"
    },
    "view-bg": {
      "light": "#ffffff",
      "dark": "#1d1d20",
      "gtk": "view_bg_color"
    },
    "view-fg": {
      "light": "#2e2e32",
      "dark": "#ffffff",
      "gtk": "view_fg_color"
    },
    "headerbar-bg": {
      "light": "#ffffff",
      "dark": "#2e2e32",
      "gtk": "headerbar_bg_color"
    },
    "headerbar-border": {
      "light": "#e3e3e6",
      "dark": "#151517",
      "gtk": "headerbar_border_color"
    },
    "sidebar-bg": {
      "light": "#ebebed",
      "dark": "#2e2e32",
      "gtk": "sidebar_bg_color"
    },
    "card-bg": {
      "light": "#ffffff",
      "dark": "#2a2a2e",
      "gtk": "card_bg_color"
    },
    "popover-bg": {
      "light": "#ffffff",
      "dark": "#36363a",
      "gtk": "popover_bg_color"
    },
    "dim": {
      "light": "#6e6e75",
      "dark": "#a8a8ae",
      "gtk": "derived: window_fg_color at 55% (libadwaita .dim-label)"
    },
    "faint": {
      "light": "#9a9aa1",
      "dark": "#77777e",
      "gtk": "derived: window_fg_color at 40%"
    },
    "borders": {
      "light": "#dcdce0",
      "dark": "#3a3a3f",
      "gtk": "borders (GTK 3) / window_fg_color at 15%"
    },
    "line2": {
      "light": "#ececef",
      "dark": "#2c2c30",
      "gtk": "derived: view_fg_color at 8% over view_bg_color"
    },
    "accent-bg": {
      "light": "#3584e4",
      "dark": "#3584e4",
      "gtk": "accent_bg_color"
    },
    "accent-fg": {
      "light": "#ffffff",
      "dark": "#ffffff",
      "gtk": "accent_fg_color"
    },
    "accent": {
      "light": "#0461be",
      "dark": "#81d0ff",
      "gtk": "accent_color"
    },
    "osd-bg": {
      "light": "#2e2e32",
      "dark": "#0f0f11",
      "gtk": "derived: window_fg_color (light) / #0f0f11 (dark)"
    },
    "osd-fg": {
      "light": "#ffffff",
      "dark": "#ffffff",
      "gtk": "derived: window_bg_color (light) / #ffffff (dark)"
    },
    "term-bg": {
      "light": "#1d1d20",
      "dark": "#141416",
      "gtk": "not mapped (fixed)"
    },
    "term-fg": {
      "light": "#e8e8ec",
      "dark": "#e8e8ec",
      "gtk": "not mapped (fixed)"
    }
  },
  "gloss-kind": {
    "$comment": "One colour per gloss kind (CSS --k on the gloss). Meaning: derive=steps, plot, hint; ask=answer, quick check; doubt=doubt, gap finder, low parse confidence; source=from your sources; prof=said in class, board, live; write=written for you; later=later, homework; mine=your own note; flag=come back.",
    "k-derive": {
      "light": "#0461be",
      "dark": "#81d0ff",
      "gtk": "blue_4 (light) / blue_1 (dark)"
    },
    "k-ask": {
      "light": "#15772e",
      "dark": "#8de698",
      "gtk": "green_5 / green_1"
    },
    "k-doubt": {
      "light": "#905300",
      "dark": "#ffc057",
      "gtk": "yellow_5 / yellow_2"
    },
    "k-source": {
      "light": "#8939a4",
      "dark": "#fba7ff",
      "gtk": "purple_4 / purple_1"
    },
    "k-prof": {
      "light": "#c00023",
      "dark": "#ff888c",
      "gtk": "red_4 / red_1"
    },
    "k-write": {
      "light": "#007184",
      "dark": "#7bdff4",
      "gtk": "teal: mix(blue_4, green_4) / mix(blue_1, green_1)"
    },
    "k-later": {
      "light": "#b62200",
      "dark": "#ff9c5b",
      "gtk": "orange_5 / orange_2"
    },
    "k-mine": {
      "light": "#526678",
      "dark": "#bbd1e5",
      "gtk": "dark_1 / light_4"
    },
    "k-flag": {
      "light": "#a2326c",
      "dark": "#ffa0d8",
      "gtk": "mix(red_4, purple_4) / mix(red_1, purple_1)"
    }
  },
  "mix": {
    "$comment": "Derived surfaces use color-mix(in srgb, A p%, B).",
    "gloss-bg": "color-mix(--k 6%, --view-bg)",
    "gloss-border": "color-mix(--k 24%, --borders)",
    "gloss-ask-bg": "color-mix(--k 9%, --view-bg)",
    "gloss-ask-border": "color-mix(--k 18%, --borders)",
    "gloss-draft-border": "dashed, color-mix(--k 55%, --borders)",
    "gloss-low-confidence-border": "1.5px dotted",
    "hover": "color-mix(--window-fg 6-8%, transparent)",
    "selected": "color-mix(--window-fg 11-12%, transparent)",
    "block-focus-bg": "color-mix(--accent 9%, transparent)",
    "block-mid-confidence-border": "1.5px dotted color-mix(--view-fg 32%, transparent)",
    "block-low-confidence": "1.5px dotted --k-doubt; background color-mix(--k-doubt 6%, transparent)",
    "pill-bg": "color-mix(--window-fg 7%, transparent)",
    "chip-bg": "color-mix(--c 13%, transparent)"
  },
  "font": {
    "ui": "\"Inter\", \"Adwaita Sans\", \"Cantarell\", ui-sans-serif, system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", \"Adwaita Mono\", \"Source Code Pro\", ui-monospace, Menlo, monospace",
    "doc": "\"Literata\", \"Iowan Old Style\", Georgia, serif",
    "math": "\"Noto Sans Math\", math, \"Cambria Math\", serif",
    "$comment": "Bundle Inter, JetBrains Mono, Literata and Noto Sans Math (OFL) so the look is the same on every OS; system fonts are fallbacks."
  },
  "type": {
    "base": "14px / 1.5 ui",
    "doc-block": "1.03rem / 1.62 doc",
    "gloss-body": "0.97rem / 1.6 doc",
    "slide-title": "1.38rem 600 doc, letter-spacing -0.005em",
    "headerbar-title": "14px 700 ui",
    "headerbar-subtitle": "11.5px dim",
    "rail-row": "12.5px 600 ui",
    "label-mono": "10.5px mono, uppercase, letter-spacing 0.05-0.06em",
    "small": "11.5px",
    "status": "11.5px mono, tabular numbers",
    "kbd": "0.8em 500 mono"
  },
  "space": {
    "$comment": "px. The demo uses a 2-4-6-8-10-12-16 rhythm.",
    "scale": [
      2,
      4,
      6,
      8,
      10,
      12,
      14,
      16,
      24,
      32
    ]
  },
  "layout": {
    "rail": "208px",
    "side-panel": "312px",
    "document-max": "800px",
    "gutter": "92px label column + 16px gap (slide heading, block, gloss share it)",
    "headerbar-min-height": "47px",
    "status-line-min-height": "27px",
    "headerbar-button": "34px square"
  },
  "radius": {
    "kbd": "5px",
    "small": "6-7px (buttons, rows, blocks)",
    "acts": "8px",
    "gloss": "10px",
    "card": "12px (app, popovers, nudge, which-key)",
    "pill": "999px"
  },
  "shadow": {
    "app": "0 1px 3px rgba(0,0,0,.12), 0 18px 44px -26px rgba(0,0,0,.5)",
    "popover": "0 14px 34px -16px rgba(0,0,0,.55)",
    "toast": "0 8px 24px -10px rgba(0,0,0,.5)",
    "acts": "0 4px 14px -6px rgba(0,0,0,.35)",
    "nudge": "0 8px 24px -16px rgba(0,0,0,.5)"
  },
  "keycap": {
    "$comment": "The 3D keycap used everywhere a key is shown (kbd, .kc buttons).",
    "font": "mono 0.8em 500",
    "min-size": "1.75em square",
    "padding": "0 0.4em",
    "border": "1px solid --borders, bottom 2px",
    "radius": "5px",
    "background": "--view-bg",
    "color": "--window-fg",
    "states": {
      "hover": "border-color --accent-bg",
      "now (next to press)": "background --accent-bg, color --accent-fg",
      "done": "opacity 0.45",
      "on-osd": "transparent background, --osd-fg, border color-mix(--osd-fg 40%)",
      "in-gloss-tag": "color --k, border color-mix(--k 45%, --borders)"
    }
  },
  "mode-colors": {
    "NORMAL": "--accent-bg on --accent-fg",
    "INSERT": "--k-ask on --view-bg",
    "VISUAL": "--k-source on --view-bg",
    "COMMAND": "--k-later on --view-bg",
    "TERMINAL": "--k-write on --view-bg"
  },
  "motion": {
    "gloss-enter": "0.35s ease-out (fade and rise)",
    "keystroke-fade": "0.5s",
    "theme-switch": "0.25s background and color",
    "reduced-motion": "no animation; instant state changes"
  }
}
