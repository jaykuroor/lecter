{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["../../ui/node_modules", "../../ui/node_modules/@types"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"]
  },
  "include": ["**/*.ts"]
}
